{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "dry_run": true,
  "dry_run_wallet": 10000,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "liquidation_buffer": 0.05,
  "timeframe": "1m",
  "strategy": "S03Strategy",
  "cancel_open_orders_on_exit": false,
  "unfilledtimeout": {
    "entry": 3,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "order_types": {
    "entry": "limit",
    "exit": "market",
    "emergency_exit": "market",
    "force_exit": "market",
    "force_entry": "market",
    "stoploss": "market",
    "stoploss_on_exchange": true,
    "stoploss_on_exchange_interval": 60
  },
  "exchange": {
    "name": "okx",
    "key": "",
    "secret": "",
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "SOL/USDT:USDT",
      "BNB/USDT:USDT"
    ],
    "pair_blacklist": [],
    "ccxt_config": {
      "cafile": "/root/.ccr/ca-bundle.crt"
    },
    "ccxt_async_config": {
      "aiohttp_trust_env": true,
      "cafile": "/root/.ccr/ca-bundle.crt"
    }
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "bot_name": "s03",
  "internals": {
    "process_throttle_secs": 5
  }
}