{
  "_说明": "OpenClaw 命令执行白名单（freqtrade 版 v1.0）：所有 agent 只通过 s03ft 一个命令操作。pattern 为命令名或路径 glob，argPattern 为对参数（不含 argv[0]）的 ECMAScript 正则，参数以单个空格连接。审批不是权限边界，真正的限制来自 sudoers、文件权限和沙箱。导入前删除以 _ 开头的键。",
  "version": 1,
  "defaults": {
    "security": "deny",
    "ask": "off",
    "askFallback": "deny"
  },
  "agents": {
    "s03-ops": {
      "security": "allowlist",
      "ask": "off",
      "askFallback": "deny",
      "allowlist": [
        {
          "pattern": "s03ft",
          "argPattern": "^(daily|status|doctor|metrics)( --json)?$"
        },
        {
          "pattern": "s03ft",
          "argPattern": "^svc (start|stop|restart) (freqtrade|monitor|gate)$"
        },
        {
          "pattern": "s03ft",
          "argPattern": "^job (events|export)$"
        },
        {
          "pattern": "s03ft",
          "argPattern": "^logs (freqtrade|monitor|gate)( --json)?$"
        },
        {
          "pattern": "s03ft",
          "argPattern": "^gate status$"
        }
      ]
    },
    "s03-analyst": {
      "security": "allowlist",
      "ask": "off",
      "askFallback": "deny",
      "allowlist": [
        {
          "pattern": "s03ft",
          "argPattern": "^gate (status|pause [^;&|`$<>\\\\\"'\\n]{1,200})$"
        }
      ]
    },
    "s03-research": {
      "security": "allowlist",
      "ask": "off",
      "askFallback": "deny",
      "allowlist": [
        {
          "pattern": "s03ft",
          "argPattern": "^doctor --research( --json)?$"
        },
        {
          "pattern": "s03ft",
          "argPattern": "^research (plan|run|verify|aggregate|g0)( [A-Za-z0-9_.=:/,-]+)*$"
        },
        {
          "pattern": "s03ft",
          "argPattern": "^events build --out research/[A-Za-z0-9_.-]+\\.json( --history)?$"
        },
        {
          "pattern": "s03ft",
          "argPattern": "^test$"
        },
        {
          "pattern": "freqtrade",
          "argPattern": "^(download-data|list-data|backtesting-analysis) -c user_data/config(-test-okx)?\\.json( [A-Za-z0-9_.=:/,-]+)*$"
        }
      ]
    },
    "s03-review": {
      "security": "deny",
      "ask": "off",
      "askFallback": "deny",
      "allowlist": []
    }
  }
}