# /etc/s03/ft-trader.env —— 属主 root，权限 0600。freqtrade 通过 FREQTRADE__ 环境变量读取（已在 freqtrade 2026.9 上测试可用）。
# Binance API Key：只勾选读取与合约交易，不开提现，限制服务器 IP。
FREQTRADE__EXCHANGE__KEY=...
FREQTRADE__EXCHANGE__SECRET=...
# freqtrade REST API 账号：与 /etc/s03/ft-monitor.env 中的 FT_API_USER / FT_API_PASS 相同
FREQTRADE__API_SERVER__USERNAME=...
FREQTRADE__API_SERVER__PASSWORD=请生成至少24位随机串
FREQTRADE__API_SERVER__JWT_SECRET_KEY=请生成至少32位随机串
FREQTRADE__API_SERVER__WS_TOKEN=请生成至少24位随机串
# 注意：dry_run 写在 /etc/s03/ft-config.json（root 所有），改为 false 属于 G9，只能由你本人操作。
