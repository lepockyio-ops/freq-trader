[Unit]
Description=服务 %i 失败时唤醒 OpenClaw 的 s03-ops agent

[Service]
Type=oneshot
DynamicUser=yes
EnvironmentFile=/etc/s03/openclaw-hooks.env
ExecStart=/usr/local/lib/s03/s03-hook s03-ops "服务 %i 进入 failed 状态。请按 s03ft-ops 技能的故障流程处理：先 s03ft logs，最多 s03ft svc restart 一次；仍失败就停止并通知 Pocky。不要改配置。"
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
