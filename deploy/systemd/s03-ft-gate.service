[Unit]
Description=S03 OpenClaw 白名单代理（127.0.0.1:8765：status 与 pause→/stopentry）
After=network-online.target s03-freqtrade.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=s03-notify-ops@%n.service

[Service]
Type=simple
User=s03trader
Group=s03trader
WorkingDirectory=/var/lib/s03-ft
StateDirectory=s03-ft
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/s03/ft-monitor.env
EnvironmentFile=/etc/s03/openclaw-gate.env
ExecStart=/opt/s03/venv/bin/python /opt/s03/ft-s03/monitor/run_monitor.py gate -c /etc/s03/monitor.toml
Restart=always
RestartSec=10
ReadWritePaths=/var/lib/s03-ft
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027

[Install]
WantedBy=multi-user.target
