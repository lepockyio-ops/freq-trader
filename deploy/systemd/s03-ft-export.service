[Unit]
Description=S-03 导出交易记录、盈亏与告警到复盘 agent 的收件目录（只读副本）
OnFailure=s03-notify-ops@%n.service

[Service]
Type=oneshot
User=s03trader
Group=s03trader
WorkingDirectory=/var/lib/s03-ft
StateDirectory=s03-ft
EnvironmentFile=/etc/s03/ft-monitor.env
Environment=S03_EVENTS_FILE=/var/lib/s03-events/events.json
Environment=S03_FT_MONITOR_DIR=/opt/s03/ft-s03/monitor
ExecStart=/opt/s03/venv/bin/python /usr/local/lib/s03/s03-ft-export /srv/s03-review/inbox
TimeoutStartSec=300
ReadWritePaths=/var/lib/s03-ft /srv/s03-review/inbox
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027
